<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    AIBrandMonitor DPI-awareness manifest.
    Requests Per-Monitor DPI awareness (v2) for crisp rendering on HiDPI displays.
    Falls back gracefully on older Windows versions.
    No UAC elevation — runs asInvoker.
  -->
  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="AIBrandMonitor"
    type="win32"
  />
  <description>AIBrandMonitor</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Per-Monitor DPI awareness v2 — supported on Windows 10 1703+ -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- For Windows 10 1607+ (recommended for most modern systems) -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Fallback for Windows 7/8.x compatibility -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>

  <!-- OS compatibility: Windows 10 and Windows 11 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
