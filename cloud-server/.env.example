SURFACED_CLOUD_ENV=development
SURFACED_CLOUD_SECRET_KEY=change-this-before-deploy
SURFACED_CLOUD_DATABASE_URL=postgresql+psycopg://surfaced:surfaced-password@postgres:5432/surfaced_cloud
SURFACED_CLOUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SURFACED_CLOUD_ADMIN_SELF_REGISTER_ENABLED=true
SURFACED_CLOUD_EMAIL_VERIFICATION_REQUIRED=true
SURFACED_CLOUD_EMAIL_CODE_TTL_MINUTES=10
SURFACED_CLOUD_EMAIL_CODE_RESEND_SECONDS=60
SURFACED_CLOUD_EMAIL_CODE_MAX_ATTEMPTS=5
SURFACED_CLOUD_EMAIL_PROVIDER=tencent_ses
SURFACED_CLOUD_TENCENT_SES_SECRET_ID=
SURFACED_CLOUD_TENCENT_SES_SECRET_KEY=
SURFACED_CLOUD_TENCENT_SES_REGION=ap-hongkong
SURFACED_CLOUD_TENCENT_SES_ENDPOINT=ses.tencentcloudapi.com
SURFACED_CLOUD_TENCENT_SES_FROM=Surfaced <no-reply@mail.surfacedlab.com>
SURFACED_CLOUD_TENCENT_SES_REPLY_TO=
SURFACED_CLOUD_TENCENT_SES_TEMPLATE_ID=0
SURFACED_CLOUD_SMTP_HOST=smtp.example.com
SURFACED_CLOUD_SMTP_PORT=587
SURFACED_CLOUD_SMTP_USERNAME=
SURFACED_CLOUD_SMTP_PASSWORD=
SURFACED_CLOUD_SMTP_FROM=Surfaced <no-reply@example.com>
SURFACED_CLOUD_SMTP_USE_TLS=true
SURFACED_CLOUD_SMTP_TIMEOUT_SECONDS=15
SURFACED_CLOUD_DOCS_ENABLED=true
SURFACED_CLOUD_PUBLIC_UPDATE_BASE_URL=https://download.example.com
SURFACED_CLOUD_API_WORKERS=2
SURFACED_CLOUD_API_WORKER_TIMEOUT_SECONDS=60
SURFACED_CLOUD_DB_POOL_SIZE=5
SURFACED_CLOUD_DB_MAX_OVERFLOW=10
SURFACED_CLOUD_DB_POOL_RECYCLE_SECONDS=1800
SURFACED_CLOUD_DB_POOL_TIMEOUT_SECONDS=30
SURFACED_CLOUD_DB_STATEMENT_TIMEOUT_MS=5000
SURFACED_CLOUD_WORKER_DB_STATEMENT_TIMEOUT_MS=60000
SURFACED_CLOUD_WORKER_POLL_SECONDS=1
SURFACED_CLOUD_WORKER_BATCH_LIMIT=100
SURFACED_CLOUD_WORKER_MAINTENANCE_ENABLED=true
SURFACED_CLOUD_WORKER_MAINTENANCE_INTERVAL_SECONDS=900
SURFACED_CLOUD_OBJECT_STORAGE_ENDPOINT_URL=
SURFACED_CLOUD_OBJECT_STORAGE_BUCKET=
SURFACED_CLOUD_OBJECT_STORAGE_REGION=auto
SURFACED_CLOUD_OBJECT_STORAGE_ACCESS_KEY_ID=
SURFACED_CLOUD_OBJECT_STORAGE_SECRET_ACCESS_KEY=
SURFACED_CLOUD_OBJECT_STORAGE_FORCE_PATH_STYLE=false
SURFACED_CLOUD_OBJECT_STORAGE_LOCAL_DIR=/opt/surfaced/object-data
SURFACED_CLOUD_OBJECT_STORAGE_LOCAL_BASE_URL=
SURFACED_CLOUD_OBJECT_STORAGE_TOTAL_QUOTA_BYTES=10737418240
SURFACED_CLOUD_OBJECT_STORAGE_WORKSPACE_QUOTA_BYTES=5368709120
SURFACED_CLOUD_OBJECT_STORAGE_MAX_FILE_BYTES=536870912
SURFACED_CLOUD_OBJECT_STORAGE_MIN_FREE_BYTES=8589934592
SURFACED_CLOUD_BACKUP_DIR=/opt/surfaced/backups
SURFACED_CLOUD_BACKUP_RETAIN_DAYS=7

POSTGRES_DB=surfaced_cloud
POSTGRES_USER=surfaced
POSTGRES_PASSWORD=surfaced-password
